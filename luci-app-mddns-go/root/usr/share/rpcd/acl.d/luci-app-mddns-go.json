{
	"luci-app-mddns-go": {
		"description": "Grant UCI access for luci-app-mddns",
		"read": {
			"uci": [ "mddns-go" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/usr/sbin/mddns-go": [ "exec" ],
				"/*": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/*": [ "write" ]
			}
		}
	}
}