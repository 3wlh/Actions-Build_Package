{
	"luci-app-bemfa-server": {
		"description": "Grant UCI access for luci-app-bemfa-server",
		"read": {
			"uci": [ "bemfa-server" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/usr/sbin/bemfa-server": [ "exec" ],
				"/*": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/*": [ "write" ]
			}
		}
	}
}